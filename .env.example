# Copy to .env.local and fill in. Set the same variables in your host (e.g. Vercel).

# Contact form email delivery (https://resend.com/api-keys).
RESEND_API_KEY=
# Sender address on a domain verified in Resend. Messages are delivered to linux@mdk0.tech.
CONTACT_FROM_EMAIL="Portfolio contact form <contact@mdk0.tech>"

# Optional captcha for the contact form (https://dashboard.hcaptcha.com).
# Leave both empty to rely on the built-in honeypot field only.
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=
